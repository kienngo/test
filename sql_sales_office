%dw 2.0
import * from dw::core::Dates
output application/json
var initialLoadFlg =  attributes.queryParams.initialLoadFlg default false
var createDateSQL = "SELECT 
    ADDRESS,
    IFA_WEB_COMMENT,
    IFA_CORP_CD,
    IPADDRESS1_1,
    IPADDRESS1_2,
    IPADDRESS1_3,
    IPADDRESS1_4,
    IPADDRESS2_1,
    IPADDRESS2_2,
    IPADDRESS2_3,
    IPADDRESS2_4,
    IPADDRESS3_1,
    IPADDRESS3_2,
    IPADDRESS3_3,
    IPADDRESS3_4,
    OFFICE_NM,
    OFFICE_CD,
    TEL1_1,
    TEL1_2,
    TEL1_3,
    DELETE_KBN,
    0 AS CATEGORY
FROM IFA_CORP_OFFICE_MST
WHERE
	CREATE_DT BETWEEN  TO_DATE(:fromDate,'YYYY-MM-DD HH24:MI:SS') AND TO_DATE(:toDate,'YYYY-MM-DD HH24:MI:SS')"

var updateDateSql = " SELECT 
    ADDRESS,
    IFA_WEB_COMMENT,
    IFA_CORP_CD,
    IPADDRESS1_1,
    IPADDRESS1_2,
    IPADDRESS1_3,
    IPADDRESS1_4,
    IPADDRESS2_1,
    IPADDRESS2_2,
    IPADDRESS2_3,
    IPADDRESS2_4,
    IPADDRESS3_1,
    IPADDRESS3_2,
    IPADDRESS3_3,
    IPADDRESS3_4,
    OFFICE_NM,
    OFFICE_CD,
    TEL1_1,
    TEL1_2,
    TEL1_3,
    DELETE_KBN,
    1 AS CATEGORY
FROM IFA_CORP_OFFICE_MST
WHERE
    UPDATE_DT BETWEEN  TO_DATE(:fromDate,'YYYY-MM-DD HH24:MI:SS') AND TO_DATE(:toDate,'YYYY-MM-DD HH24:MI:SS')
    AND NOT (
        CREATE_DT BETWEEN  TO_DATE(:fromDate,'YYYY-MM-DD HH24:MI:SS') AND TO_DATE(:toDate,'YYYY-MM-DD HH24:MI:SS')
    )
"
---
if(initialLoadFlg) createDateSQL 
		else (createDateSQL ++ " UNION " ++ updateDateSql)

%dw 2.0
import * from dw::util::Coercions
output application/json
---
(flatten(payload.payload) default []) map{
	"address": $.ADDRESS default "",
	"comment": $.IFA_WEB_COMMENT default "",
	"corporateCode": toString($.IFA_CORP_CD) default "",
	"ipAddress1_1": $.IPADDRESS1_1 default "",
	"ipAddress1_2": $.IPADDRESS1_2 default "",
	"ipAddress1_3": $.IPADDRESS1_3 default "",
	"ipAddress1_4": $.IPADDRESS1_4 default "",
	"ipAddress2_1": $.IPADDRESS2_1 default "",
	"ipAddress2_2": $.IPADDRESS2_2 default "",
	"ipAddress2_3": $.IPADDRESS2_3 default "",
	"ipAddress2_4": $.IPADDRESS2_4 default "",
	"ipAddress3_1": $.IPADDRESS3_1 default "",
	"ipAddress3_2": $.IPADDRESS3_2 default "",
	"ipAddress3_3": $.IPADDRESS3_3 default "",
	"ipAddress3_4": $.IPADDRESS3_4 default "",
	"salesOfficeName": $.OFFICE_NM default "",
	"officeCode": toString($.OFFICE_CD) default "",
	"tel1_1": $.TEL1_1 default "",
	"tel1_2": $.TEL1_2 default "",
	"tel1_3": $.TEL1_3 default "",
	"isDeleted": toString($.DELETE_KBN) default ""
	
}

%dw 2.0
output application/json
---
if(not isEmpty(payload))   
{
    "address": payload.address,
	"comment": payload.comment default "",
	"fixedIP1": payload.ipAddress1_1 default "" ++ "." ++ payload.ipAddress1_2 default "" ++ "." ++ payload.ipAddress1_3 default "" ++ "." ++ payload.ipAddress1_4 default "",
	"fixedIP2": payload.ipAddress2_1 default "" ++ "." ++ payload.ipAddress2_2 default "" ++ "." ++ payload.ipAddress2_3 default "" ++ "." ++ payload.ipAddress2_4 default "",
	"fixedIP3": payload.ipAddress3_1 default "" ++ "." ++ payload.ipAddress3_2 default "" ++ "." ++ payload.ipAddress3_3 default "" ++ "." ++ payload.ipAddress3_4 default "",
	"salesOfficeName": payload.salesOfficeName,
	"officeCode": payload.officeCode,
	"corporateName": payload.corporateCode,
	"telNumber": payload.tel1_1 default "" ++ "-" ++  payload.tel1_2  default "" ++ "-" ++ payload.tel1_3 default "",
	"officeKey": payload.corporateCode default "" ++ "-" ++ payload.officeCode default "",
	"isDeleted": if(payload.isDeleted == "0")"false" else if (payload.isDeleted == "1")"true" else null
} else []

%dw 2.0
import toBoolean from dw::util::Coercions

output application/json
---
if(not isEmpty(payload))
payload map{
	"CWR_Address__c": $.address,
	"CWR_Comment__c": $.comment,
	"CWR_IP1__c": $.fixedIP1,
	"CWR_IP2__c": $.fixedIP2,
	"CWR_IP3__c": $.fixedIP3,
	"Name": $.salesOfficeName,
	"CWR_Office_code__c": $.officeCode,
	"CWR_Corporate__r": {"cd_ifa_corp__c":$.corporateName},
	"CWR_Telephone_number__c": $.telNumber,
	"CWR_Office_key__c": $.officeKey,
	"CWR_Logical_delete_business_office__c": toBoolean($.isDeleted)
}
else []
