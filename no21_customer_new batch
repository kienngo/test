" SELECT /*+ APL-270500017 */ 
     (CASE LENGTH(C.CLIENT_CD)
     WHEN 9 THEN SUBSTR(C.CLIENT_CD , 1 , 3)
     WHEN 6 THEN (SELECT DECODE(SUBSTR(NAME,-6),'RSDB01','701','RSDB02','708','RSDB03','702','RSDB04','703','RSDB05','704','RSDB06','705','RSDB07','706','RSDB08','707','RSDB09','709') FROM V\$DATABASE)
     ELSE NULL END  ||
      CASE LENGTH (C.CLIENT_CD)
      WHEN 9 THEN SUBSTR (C.CLIENT_CD, 4)
      ELSE TO_CHAR (C.CLIENT_CD)
     END) AS CUSTOMER_CD,
     C.BRANCH_CD,
     C.CLIENT_CD,
     E.ISA_APPLY_STS,
     F.ACC_STATUS,
     G.MAIN_PERSON_KBN,
     ( CASE 
        WHEN EXISTS (
            SELECT 1 FROM RELATION_ACC_MNG RAM WHERE RAM.USER_ID = B.USER_ID
            UNION 
            SELECT 1 FROM GROUP_ID_MNG GIM WHERE GIM.USER_ID = B.USER_ID
        ) 
    THEN 'TRUE'
    ELSE 'FALSE'
    END) AS IS_CHILD_ACCOUNT,
     H.NISA_OPN_DT,
     H.NISA_CLS_DT,
     U.SPA_APPL_FLG,
     B.CLNT_NM,
     B.CLNT_KANA_NM,
     B.GENDER_KBN,
     B.NATIONALITY,
     B.BIRTH_DT,
     B.EXTNL_TEL_NO,
     B.LOCAL_TEL_NO,
     B.TEL_NO,
     B.MOBILE_PHONE_NO_1, 
     B.MOBILE_PHONE_NO_2,
     B.MOBILE_PHONE_NO_3,
     U.CONTACT_PRIORITY_1,
     B.ADDRS_KNJ_1,
     B.ADDRS_KNJ_2,
     B.ADDRS_KNJ_3,
     C.IFA_CONTRACT_KBN,
     A.MARGIN_ACC_OPN_FLG,
     A.MARGIN_ACC_OPN_DT,
     A.MARGIN_ACC_CLS_FLG,
     A.MARGIN_ACC_CLS_DT,
     A.US_MG_ACC_OPN_FLG ,
     A.US_MG_ACC_OPN_DT,
     A.US_MG_ACC_CLS_FLG,
     A.US_MG_ACC_CLS_DT,
     A.M_SPA_KBN,
     D.TM_COMMISSION_COURSE,
     C.IFA_STOCK_COMM_CHG_DT,
     C.IFA_COMMISSION_FLG,
     C.IFA_COMM_CHG_DT,
     C.IFA_SPRD_DSCT_FLG,
     C.IFA_SPRD_DSCT_DT,
     T.USER_ID,
     T.USER_ID_CONSIGNOR,
     T.USER_ID_TRUSTEE,
     B.OCCUPATION_CD,
     U.COMP_DSCR_CD,
     U.TYPE_OF_BUSINESS,
     B.COMP_NM,
     U.AFFILICATION_POST,
     B.POSITION,
     O.DIV_FLG_EXECTIVE,
     O.DIV_FLG_EMPLOYEE,
     O.DIV_FLG_LARGE_STOCKHOLDER,
     O.DIV_FLG_MAIN_STOCKHOLDER,
     O.DIV_FLG_BLOOD_GROUP,
     O.DIV_FLG_SPOUSE,
     B.FNCL_ASST_RANGE_KBN,
     B.INVST_PLN_MSK,
     B.EXP_INVST_MSK,
     B.MOVEMNT_MSK,
     U.TRANSACTION_MOTIVE_OTHERS,
     B.INTRST_INVST_MSK,
     U.INTRST_INVST_MSK_OTHERS,
     C.IFA_CORP_CD,
     M.OFFICE_CD,
     C.IFA_CHARGE_CD,
     N.CODE_TEXT AS INV_POLICY,
     U.DECLARED_AMOUNT,
     (
        SELECT LISTAGG(N.CODE_TEXT, '、')
               WITHIN GROUP (ORDER BY N.CODE_NO)
        FROM (
            SELECT REGEXP_SUBSTR(U.TYPE_OF_INCOME, '[^/]+', 1, LEVEL) AS CODE
            FROM DUAL
            CONNECT BY LEVEL <= REGEXP_COUNT(U.TYPE_OF_INCOME, '/') + 1
        ) t
        LEFT JOIN ACC_INV_TYP_FIN_ITEM_MST N
    ON N.CODE_NO = t.CODE
    AND N.ITEM_KBN(+) = 2
    ) AS TYPE_OF_INCOME,
    U.TYPE_OF_INCOME_OTH 
    FROM      
         BV_USER_PROFILE B,
         IFA_CLNT_CONTRL C,
         USER_PROFILE_ADD_INFO U,
         ACC_INV_TYP_FIN_ITEM_MST N,
         TRUST_ACC_MNG T,
         BV_USER_ACCOUNT A,
         CLIENT_COMMISSION D,
         IFA_CHARGE_MSTR M,
         OWN_INSIDER O,
         CLNT_ISA_MNG E,
         TRUST_ACC_MNG F,
         RELATION_ACC_MNG G,
         SNISA_TAX_FREE_LMT H
     
     WHERE 
     1=1 AND 
     C.CLIENT_CD  = B.CLIENT_CD(+) AND
     B.USER_ID = A.USER_ID(+) AND
     B.USER_ID = U.USER_ID(+) AND
     U.INV_POLICY = N.CODE_NO(+) AND 
	 N.ITEM_KBN(+) = 1 AND 
     B.USER_ID = E.USER_ID(+) AND
     B.USER_ID = F.USER_ID(+) AND
     B.USER_ID = G.USER_ID(+) AND
     C.IFA_CORP_CD = M.IFA_CORP_CD(+) AND 
     C.IFA_CHARGE_CD = M.IFA_CHARGE_CD(+) AND  
     C.CLIENT_CD = T.CLIENT_CD(+) AND 
     C.CLIENT_CD = D.CLIENT_CD(+) AND 
     C.CLIENT_CD = O.CLIENT_CD(+) AND
     C.CLIENT_CD = H.CLIENT_CD(+) AND
     C.CLIENT_CD IN (SELECT CLIENT_CD
    FROM IFA_CLNT_CONTRL B WHERE 1=1 AND CREATE_DT BETWEEN  TO_DATE(:fromDate,'YYYY-MM-DD HH24:MI:SS')
        AND TO_DATE(:toDate,'YYYY-MM-DD HH24:MI:SS')) "
  
        
        
